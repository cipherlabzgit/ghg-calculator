# Reseller-only PIN to show emission factors on this device.
# Leave empty so factors stay hidden for everyone (end-customer default).
# Give this PIN only to the handover customer — not to the people they sell to.
# This is baked into the client bundle. It is not API authentication.
VITE_OPERATOR_PIN=

# Production: origin + `/api` prefix (no trailing slash). Leave empty for local Vite proxy.
# Example: https://api.example.com/api
VITE_API_BASE_URL=
