# These variables are NOT loaded automatically. The Node process does not read this file.
# Supply them in the office-server environment (service manager, reverse-proxy host env,
# or a shell export) before starting the compiled API.

# HTTP listen port. Defaults to 3001 if unset.
PORT=3001

# Comma-separated browser origins allowed to call the API.
# Required for production when the frontend is on a different host (for example Vercel).
# Include the local Vite origin if you still call this server from `npm run dev`.
# Example: https://your-frontend.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Set to production on the live server.
NODE_ENV=production
